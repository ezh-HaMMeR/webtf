+EMSCRIPTEN_KEEPALIVE const char *WebTF_TrackedName(void)
+{
+	static char name[MAX_SCOREBOARDNAME];
+	int track = WebTF_ViewPlayerNum();
+
+	if (track < 0 || track >= MAX_CLIENTS)
+		return "";
+
+	strlcpy(name, cl.players[track].name, sizeof(name));
+	return Q_normalizetext(name);
+}
+
+static const char *WebTF_NormalizedText(const char *source)
+{
+	static char text[MAX_INFO_STRING];
+
+	strlcpy(text, source, sizeof(text));
+	return Q_normalizetext(text);
+}
+
+EMSCRIPTEN_KEEPALIVE int WebTF_MaxClients(void)
+{
+	return MAX_CLIENTS;
+}
+
+EMSCRIPTEN_KEEPALIVE int WebTF_PlayerActive(int slot)
+{
+	return slot >= 0 && slot < MAX_CLIENTS && cl.players[slot].name[0];
+}
+
+EMSCRIPTEN_KEEPALIVE int WebTF_PlayerSpectator(int slot)
+{
+	return slot >= 0 && slot < MAX_CLIENTS && cl.players[slot].spectator;
+}
+
+EMSCRIPTEN_KEEPALIVE const char *WebTF_PlayerName(int slot)
+{
+	return WebTF_PlayerActive(slot) ? WebTF_NormalizedText(cl.players[slot].name) : "";
+}
+
+EMSCRIPTEN_KEEPALIVE const char *WebTF_PlayerTeam(int slot)
+{
+	return WebTF_PlayerActive(slot) ? WebTF_NormalizedText(cl.players[slot].team) : "";
+}
+
+EMSCRIPTEN_KEEPALIVE int WebTF_PlayerFrags(int slot)
+{
+	return WebTF_PlayerActive(slot) ? cl.players[slot].frags : 0;
+}
+
+EMSCRIPTEN_KEEPALIVE int WebTF_PlayerPing(int slot)
+{
+	return WebTF_PlayerActive(slot) ? cl.players[slot].ping : 0;
+}
+
+EMSCRIPTEN_KEEPALIVE void WebTF_TrackRelative(int direction)
+{
+	int current = Cam_TrackNum();
+	int step = direction < 0 ? -1 : 1;
+	int i;
+
+	Cmd_ExecuteString("mvd_autotrack 0");
+	Cmd_ExecuteString("demo_autotrack 0");
+	Cmd_ExecuteString("cl_hightrack 0");
+
+	for (i = 1; i <= MAX_CLIENTS; ++i) {
+		int slot = (current + step * i + MAX_CLIENTS * 2) % MAX_CLIENTS;
+		if (cl.players[slot].name[0] && !cl.players[slot].spectator) {
+			cl.autocam = CAM_TRACK;
+			Cam_Lock(slot);
+			cl.ideal_track = slot;
+			cl.spec_locked = true;
+			return;
+		}
+	}
+}
+
+EMSCRIPTEN_KEEPALIVE void WebTF_CloseMenus(void)
+{
+	M_LeaveMenus();
+}
