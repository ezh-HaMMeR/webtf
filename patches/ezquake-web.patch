+{
+	return cls.demoplayback ? max(0.0, cls.demotime - demostarttime) : 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE double WebTF_DemoLength(void)
+{
+	return cls.demoplayback ? max(0.0, CL_GetDemoLength()) : 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE void WebTF_DemoSeek(double seconds)
+{
+	double length;
+
+	if (!cls.demoplayback)
+		return;
+
+	length = CL_GetDemoLength();
+	if (length <= 0.0)
+		return;
+
+	seconds = bound(0.0, seconds, length);
+	CL_Demo_Jump(seconds, 0, DST_SEEKING_NORMAL);
+}
+
+EMSCRIPTEN_KEEPALIVE double WebTF_Volume(void)
+{
